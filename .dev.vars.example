# Copy to .dev.vars for `npm run dev`. In production the key is a Worker
# secret: `npx wrangler secret put DASH_KEY`.
DASH_KEY=local-dev-key
# wrangler dev is plain HTTP; the live desk refuses HTTP unless this is off.
HTTPS_ONLY=off
# A local Postgres of your own (`createdb desk_dev`). Never the live Neon
# database: local runs would write to the real list.
DATABASE_URL=postgres://localhost/desk_dev

# Going live from the desk (README, "Going live from the desk"). Without all
# five, /api/golive/* answers 503 golive-not-set-up and the rest of the desk
# works as before. In production each one is a Worker secret too.
# Not CF_API_TOKEN and CF_ACCOUNT_ID: wrangler reads those from your shell as
# its own deploy credentials, so the desk's are named apart.
# The Cloudflare API token that changes the client zones' DNS and Workers:
# GOLIVE_API_TOKEN=
# The Cloudflare account that holds the client zones and their Workers:
# GOLIVE_ACCOUNT_ID=
# The Cloudflare Access team, <team>.cloudflareaccess.com:
# ACCESS_TEAM_DOMAIN=
# The Access application's Audience (AUD) tag:
# ACCESS_AUD=
# Who may go live: email addresses, separated by commas or spaces:
# GOLIVE_EMAILS=

# Passwords on services are encrypted with this key (src/secrets.js): 32
# random bytes, base64, such as the output of `openssl rand -base64 32`. Use a
# key of your own locally, never the live one. Without it, saving a password
# is refused.
# CREDENTIALS_KEY=
# Logging in from a UiD without the key (README, "Logging in from a UiD").
# wrangler.jsonc names Paolo's and Ethan's UiDs and their public keys; to
# try it locally, name a UiD of your own and its key here instead:
# UID_LOGINS={"http://localhost:8080":{"key":"<32 bytes, base64url>","emails":["paolo@tboxstudio.com"]}}

# The client form's emails go through Resend. Without a key the form still
# saves, and says the emails were not sent.
# RESEND_API_KEY=
