{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  // pg, the Postgres driver, needs Node's APIs; it reaches Neon over a TCP
  // socket. The address is the DATABASE_URL secret.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request, not just /api/*: the Worker turns plain HTTP away.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The old home of the list, kept only until its rows are copied into
  // Postgres (src/worker.js, ready()). Its data is left untouched.
  "durable_objects": {
    "bindings": [{ "name": "DESK", "class_name": "Desk" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Desk"] }],
  // The desk has one address. The workers.dev and preview URLs would be
  // second, unlisted copies of it, so both are off.
  "routes": [{ "pattern": "website.10xid.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Query strings are dropped from logs, so nothing sent in a URL is kept.
  "observability": { "enabled": true, "redact_query_string": true },
  // The client form's emails (src/notify.js): who they come from, and the
  // rep that Notify rep writes to. Not secrets. The Resend key and the key
  // passwords are encrypted with are secrets: RESEND_API_KEY and
  // CREDENTIALS_KEY (README).
  //
  // UID_LOGINS: the UiDs that log a browser in to the desk without the key,
  // each with its public key and who it may log in (src/uid-login.js). Only
  // a public key, so not a secret: the private key that signs the passes is
  // the WEBSITE_DESK_SIGNING_KEY variable on that UiD's own service.
  "vars": {
    "FORM_EMAIL_FROM": "10XiD <noreply@brandingcentres.com>",
    "FORM_EMAIL_REP": "paolo@tboxstudio.com",
    "UID_LOGINS": {
      "https://uid-bypaolo.10xid.com": {
        "key": "JiTXc0DAsfl2zBtPZG1zMqMmRrPVI0eRRPZO-wt86BM",
        "emails": ["paolo@tboxstudio.com"]
      }
    }
  }
}
